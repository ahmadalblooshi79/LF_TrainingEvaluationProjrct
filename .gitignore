# بيئة بايثون وملفات مؤقتة — يُفضّل إبقاؤها مستثناة (حجم كبير وغير محمول بين الأجهزة)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
# أسرار محلية (مفاتيح، كلمات مرور) — لا تُرفع أبداً
.env
exercises.db
exercises.db-wal
exercises.db-shm
# سجلات تشغيل محلية
server-*.log
_server_*.txt
_transcript_snippets.txt
# صور خلفية مؤقتة (غير مستخدمة)
app/static/images/
!app/static/images/crests/
!app/static/images/crests/**
# مخرجات بناء Setup — لا تُرفع (مع الإبقاء على APK المحكمين وPWA)
dist/*
!dist/*.apk
!dist/tablet_pwa/
!dist/tablet_pwa/**
build/
*.spec
packaging/*.7z
packaging/advanced_installer/*.aip
packaging/staging/

# Flutter
flutter_app/.dart_tool/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.packages
flutter_app/build/
flutter_app/.pub-cache/
flutter_app/.pub/

# Local Flutter SDK (downloaded by agent/build scripts)
tools/flutter/

# تطبيق النظام رقم 2 — مخرجات بناء Android فقط (المصادر تُرفع)
system_tablet/.gradle/
system_tablet/build/
system_tablet/app/build/
system_tablet/local.properties
system_tablet/.idea/
system_tablet/*.iml
system_tablet/captures/
system_tablet/.cxx/

