<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lf_bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/settings_title"
            android:textColor="@color/lf_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عنوان IP للسيرفر المحلي"
            android:textColor="@color/lf_text" />

        <EditText
            android:id="@+id/inputHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="192.168.1.10"
            android:inputType="textUri"
            android:textColor="@color/lf_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="المنفذ (Port)"
            android:textColor="@color/lf_text" />

        <EditText
            android:id="@+id/inputPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="8005"
            android:inputType="number"
            android:textColor="@color/lf_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="رمز حماية الإعدادات (PIN)"
            android:textColor="@color/lf_text" />

        <EditText
            android:id="@+id/inputPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="****"
            android:inputType="numberPassword"
            android:textColor="@color/lf_text" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/lf_header"
            android:text="حفظ وفتح النظام"
            android:textColor="@color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="التطبيق يتصل بالسيرفر عبر شبكة Wi‑Fi الداخلية فقط. لا يُطلب إدخال العنوان في كل مرة بعد الحفظ."
            android:textColor="#556"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
