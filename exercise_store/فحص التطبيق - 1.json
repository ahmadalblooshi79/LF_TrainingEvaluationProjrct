  "objectives": [
    {
      "id": 1,
      "sort_order": 0,
      "text": "تقييم القادة وهيئة ركن مجموعة اللواء المتدرب باستخدام نظام مشبهات لعبات الحرب (كورا) من خلال تنفيذ قيادة المهمة في العمليات الدفاعية وتنفيذ واجبات مختارة من قائمة الواجبات الأساسية للمهمة.",
      "created_at": "2026-07-04T20:39:13.296541"
    },
    {
      "id": 2,
      "sort_order": 1,
      "text": "تنفيذ عملية صنع القرار العسكري لتجهيز خطط وأوامر العمليات.",
      "created_at": "2026-07-04T20:39:13.296544"
    },
    {
      "id": 3,
      "sort_order": 2,
      "text": "تقييم مركز قيادة مجموعة اللواء والكتائب مع التركيز على إدارة المعلومات، إعداد تقديرات الموقف، كيفية إسناد هيئة الركن لعملية صنع القرار، عمل إيجازات تبديل المناوبات، إيجازات تحديث معلومات القائد ورفع التقارير للمستوى الأعلى.",
      "created_at": "2026-07-04T20:39:13.296545"
    },
    {
      "id": 4,
      "sort_order": 3,
      "text": "الإشراف على تخطيط نيران الإسناد المشتركة ونيران مدفعية الاسناد المباشر.",
      "created_at": "2026-07-04T20:39:13.296546"
    },
    {
      "id": 5,
      "sort_order": 4,
      "text": "التأكد من إلمام الوحدة المتدربة بالعقائد والإجراءات والأساليب التعبوية للقوات البرية.",
      "created_at": "2026-07-04T20:39:13.296547"
    },
    {
      "id": 6,
      "sort_order": 5,
      "text": "التقييم على استخدام نظام الاتصالات التعبوية (C4I ).",
      "created_at": "2026-07-04T20:39:13.296548"
    }
  ],
